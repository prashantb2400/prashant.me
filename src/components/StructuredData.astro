---
import { SITE } from "@/consts";

export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

const defaultImage = new URL(SITE.ogImage, SITE.website).href;
const aboutUrl = new URL("/about", SITE.website).href;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || SITE.author,
      url: aboutUrl,
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: SITE.author,
      logo: {
        "@type": "ImageObject",
        url: defaultImage,
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || defaultImage,
    articleSection: data.tags?.[0] || "General",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.author,
    url: SITE.website,
    image: defaultImage,
    sameAs: [
      "https://github.com/prashantb2400",
      "https://twitter.com/knightofslights",
      "https://www.linkedin.com/in/prashant-bhushan-3815a535a/",
    ],
    jobTitle: "Developer & Law Student",
    description: SITE.desc,
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    url: SITE.website,
    description: SITE.desc,
    author: {
      "@type": "Person",
      name: SITE.author,
    },
    potentialAction: {
      "@type": "SearchAction",
      target: new URL("/search?q={search_term_string}", SITE.website).href,
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
